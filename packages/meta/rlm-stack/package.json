{
  "name": "@koi/rlm-stack",
  "description": "L3 composition wiring @koi/middleware-rlm with @koi/context-manager threshold coordination",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../../scripts/run-tsup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test"
  },
  "koi": {
    "optional": true
  },
  "dependencies": {
    "@koi/context-manager": "workspace:*",
    "@koi/core": "workspace:*",
    "@koi/middleware-rlm": "workspace:*",
    "@koi/token-estimator": "workspace:*"
  },
  "devDependencies": {
    "@koi/engine-compose": "workspace:*",
    "@koi/middleware-tool-disclosure": "workspace:*"
  }
}
