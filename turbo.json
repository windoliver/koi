{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../../scripts/run-tsup.ts"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../../scripts/run-runtime-package-tests.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "test:api": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**/*.ts", "dist/**/*.d.ts"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:layers": {
      "inputs": ["packages/*/*/package.json", "packages/*/*/src/**/*.ts", "scripts/layers.ts"],
      "outputs": [],
      "cache": true
    }
  }
}
